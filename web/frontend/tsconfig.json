{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "types": [
            "node"
        ],
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": false,
        "noEmit": true
    },
    "include": [
        "src/**/*"
    ]
}